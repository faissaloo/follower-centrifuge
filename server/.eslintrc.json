{
  "root": true,
  "env": {
    "node": true,
    "es2021": true
  },
  "extends": ["eslint:recommended"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "globals": {
    "AbortController": "readonly",
    "fetch": "readonly",
    "URL": "readonly",
    "Buffer": "readonly"
  },
  "rules": {
    "no-console": "off"
  },
  "overrides": [
    {
      "files": ["*.d.mts"],
      "parser": "@typescript-eslint/parser",
      "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module"
      },
      "rules": {
        "no-undef": "off",
        "no-unused-vars": "off"
      }
    }
  ]
}
